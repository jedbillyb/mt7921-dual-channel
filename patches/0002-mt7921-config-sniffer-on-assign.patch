+++ b/drivers/net/wireless/mediatek/mt76/mt7921/main.c	2026-08-02 23:32:34.605125400 +1200
@@ -1436,12 +1436,51 @@
 	mt7921_abort_roc(mvif->phy, mvif);
 }
 
+static int mt7921_assign_vif_chanctx(struct ieee80211_hw *hw,
+				     struct ieee80211_vif *vif,
+				     struct ieee80211_bss_conf *link_conf,
+				     struct ieee80211_chanctx_conf *ctx)
+{
+	struct mt792x_vif *mvif = (struct mt792x_vif *)vif->drv_priv;
+	struct mt792x_phy *phy = mt792x_hw_phy(hw);
+	int ret;
+
+	ret = mt792x_assign_vif_chanctx(hw, vif, link_conf, ctx);
+	if (ret)
+		return ret;
+
+	/*
+	 * A freshly created chanctx never passes through ->change_chanctx, so
+	 * the only call site of mt7921_mcu_config_sniffer() is unreachable for
+	 * the case that matters: a monitor vif being assigned a context of its
+	 * own. Without this the kernel happily reports mon0 on ch149 while the
+	 * firmware carries on receiving the associated BSS's channel - the
+	 * chanctx is accepted and silently ignored. Measured: `iw set freq
+	 * 5745` returns 0, the association survives, and every captured frame
+	 * is still 2417 MHz.
+	 *
+	 * Push the sniffer channel down here so the assignment reaches the
+	 * hardware. Whether the firmware services it as a receive context
+	 * independent of the BSS channel is the open question this answers.
+	 */
+	if (vif->type == NL80211_IFTYPE_MONITOR) {
+		mt792x_mutex_acquire(phy->dev);
+		ret = mt7921_mcu_config_sniffer(mvif, ctx);
+		mt792x_mutex_release(phy->dev);
+		if (ret)
+			dev_err(phy->dev->mt76.dev,
+				"sniffer channel config failed: %d\n", ret);
+	}
+
+	return ret;
+}
+
 static int mt7921_switch_vif_chanctx(struct ieee80211_hw *hw,
 				     struct ieee80211_vif_chanctx_switch *vifs,
 				     int n_vifs,
 				     enum ieee80211_chanctx_switch_mode mode)
 {
-	return mt792x_assign_vif_chanctx(hw, vifs->vif, vifs->link_conf,
+	return mt7921_assign_vif_chanctx(hw, vifs->vif, vifs->link_conf,
 					 vifs->new_ctx);
 }
 
